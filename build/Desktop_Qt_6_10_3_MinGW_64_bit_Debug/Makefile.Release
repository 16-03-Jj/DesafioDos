####### Compile

release/Plataforma.o: ../../Plataforma.cpp ../../Plataforma.h \
		../../Lista.h \
		../../Medidor.h \
		../../MatrizAmistad.h \
		../../Texto.h \
		../../Usuario.h \
		../../Album.h \
		../../Foto.h \
		../../Fecha.h \
		../../Mensaje.h \
		../../Solicitud.h \
		../../LectorLinea.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\Plataforma.o ..\..\Plataforma.cpp

release/album.o: ../../album.cpp ../../Album.h \
		../../Foto.h \
		../../Fecha.h \
		../../Lista.h \
		../../Medidor.h \
		../../Texto.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\album.o ..\..\album.cpp

release/fecha.o: ../../fecha.cpp ../../Fecha.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\fecha.o ..\..\fecha.cpp

release/foto.o: ../../foto.cpp ../../Foto.h \
		../../Fecha.h \
		../../Lista.h \
		../../Medidor.h \
		../../Texto.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\foto.o ..\..\foto.cpp

release/lectorlinea.o: ../../lectorlinea.cpp ../../LectorLinea.h \
		../../Fecha.h \
		../../Texto.h \
		../../Medidor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release\lectorlinea.o ..\..\lectorlinea.cpp

